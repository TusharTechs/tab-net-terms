# ---------- Airwallex (sandbox, US entity) ----------
AWX_BASE_URL=https://api.sandbox.airwallex.com
AWX_FILES_URL=https://files.sandbox.airwallex.com
AWX_ACCOUNT_ID=
AWX_CLIENT_ID=
AWX_API_KEY=
# Webhook signing secret (Developer -> Webhooks), used to verify HMAC-SHA256
AWX_WEBHOOK_SECRET=

# ---------- Metal testnet ----------
METAL_NETWORK=testnet
METAL_CHAIN_ID=63825
# Your own RPC endpoint from console-testnet.metalntwx.com
METAL_RPC_URL=
# Paths to key files written by metal-agent (kept in ./keys, git-ignored)
METAL_SUPPLIER_ISSUER_KEY_FILE=./keys/supplier-issuer.key
METAL_SUPPLIER_MANDATE_KEY_FILE=./keys/supplier-mandate.key
METAL_BUYER_OWNER_KEY_FILE=./keys/buyer-owner.key

# ---------- T:0 (key and MCP endpoint issued by T:0) ----------
T0_USERNAME=
T0_API_KEY=

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Airi CLI ----------
# airi-cli keeps its own login (airi-cli auth login); nothing to set here.

# Claude: "anthropic" (API key) or "bedrock" (AWS)
CLAUDE_PROVIDER=anthropic
BEDROCK_REGION=us-west-2
